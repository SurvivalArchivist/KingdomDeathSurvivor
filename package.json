{
  "name": "kingdom-death-survivors",
  "version": "3.2.1",
  "description": "Desktop companion app for Kingdom Death survivor management.",
  "desktopName": "kingdom-death-survivors.desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "verify": "bash scripts/verify.sh",
    "preflight": "bash scripts/preflight.sh",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac dmg zip",
    "package:win": "electron-builder --win nsis portable",
    "package:linux": "electron-builder --linux AppImage deb rpm tar.gz flatpak",
    "package:linux:release": "electron-builder --linux AppImage deb rpm tar.gz",
    "package:linux:x64": "electron-builder --linux tar.gz deb rpm --x64",
    "package:linux:arm64": "electron-builder --linux tar.gz deb rpm --arm64",
    "package:dir": "electron-builder --dir",
    "smoke:linux:packaged": "bash scripts/smoke-linux-packaged.sh",
    "build:mac:local": "bash scripts/build-macos-local.sh",
    "test": "npm run test:unit && npm run test:integration && npm run test:main && npm run test:renderer",
    "test:unit": "node --test test/compile.test.js",
    "test:integration": "node --test test/dataService.test.js test/dataService.edge.test.js test/dataService.schema.test.js test/dataService.util.test.js test/dataService.template.test.js test/dataService.filesystem.test.js test/settlementService.test.js test/survivorProvider.test.js test/lanSurvivorHost.test.js",
    "test:main": "node --test test/main.ipc.test.js test/main.handlers.test.js",
    "test:renderer": "node --test test/renderer.smoke.test.js"
  },
  "keywords": [],
  "author": "KDM Survivors Console Maintainers <maintainers@kdm-survivors.local>",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.kdm.survivors",
    "productName": "KDM Survivors Console",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "!dist/**/*",
      "!release/**/*",
      "!docs/**/*",
      "!test/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "ui/assets/app-icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ui/assets/app-icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz",
        "flatpak"
      ],
      "category": "Utility",
      "maintainer": "KDM Survivors Console Maintainers <maintainers@kdm-survivors.local>",
      "icon": "ui/assets/linux-icons",
      "syncDesktopName": true,
      "artifactName": "kingdom-death-survivors-${version}-linux-${arch}.${ext}"
    },
    "flatpak": {
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "41.10.4",
    "electron-builder": "26.15.7"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "markdown-it": "^14.3.0"
  }
}
